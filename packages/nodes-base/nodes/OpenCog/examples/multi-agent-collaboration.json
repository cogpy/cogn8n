      "id": "opencog",
      "name": "OpenCog"
    },
    {
      "id": "multi-agent",
      "name": "Multi-Agent"
    },
    {
      "id": "collaboration",
      "name": "Collaboration"
    }
  ],
  "triggerCount": 0,
